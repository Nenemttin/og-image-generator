# TinyOG Environment Variables Example
# Copy this file to .env.local for local development or configure in Vercel Environment Variables.

# [Optional] Master Pro license key for local development / testing bypass
# When provided, requests matching this key bypass external Lemon Squeezy API validation.
PRO_LICENSE_KEY=your_test_license_key_here

# [Optional] Lemon Squeezy Checkout URL (Defaults to the live production checkout URL if omitted)
# Format: https://<your-store>.lemonsqueezy.com/checkout/buy/<variant-uuid>
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=https://tinyog.lemonsqueezy.com/checkout/buy/f3a4a41a-fcd9-4e51-aaf0-5014089676a3

# [Optional & Recommended] Lemon Squeezy Store ID for cross-store key isolation
# Ensures only license keys generated by your store are considered valid.
# Found in Lemon Squeezy Dashboard > Settings > Stores (e.g. 12345)
LEMONSQUEEZY_STORE_ID=

# [Optional] Set to "true" to allow license keys generated in Lemon Squeezy Test Mode.
# Keep unset or "false" in Production to strictly enforce Live mode purchases.
LEMONSQUEEZY_ALLOW_TEST_MODE=false
